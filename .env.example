# Copy to .env. Keep real credentials in .env, never commit them.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
# Qwen3 dialogue mode; set default to restore the model's reasoning default.
GROQ_REASONING_EFFORT=none
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_TTS_SAMPLE_RATE=24000
DEEPGRAM_TTS_SPEED=0.82

# Run the independent OpenSpline GPU service on this machine.
AVATAR_ENABLED=true
AVATAR_QUALITY=low
AVATAR_PORTRAIT=code/static/tutor-portrait.png
AVATAR_TIMEOUT=180
OPENSPLINE_URL=http://localhost:7860

# Cloud alternative: replace OPENSPLINE_URL above with the current Cloud API.
# The pinned SDK's default dashboard URL redirects and cannot create a session.
# OPENSPLINE_URL=https://app.openspline.dev/api
# OPENSPLINE_API_KEY=
# AVATAR_START_TIMEOUT=180
# AVATAR_ID=your-saved-cloud-avatar-id
